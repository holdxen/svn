diff --git a/CMakeLists.txt b/CMakeLists.txt
index e950c058f7..b407dbea49 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -96,6 +96,7 @@ option(SVN_ENABLE_AUTH_KWALLET "Enable KWallet auth library" OFF)
 option(SVN_ENABLE_AUTH_GNOME_KEYRING "Enable GNOME Keyring for auth credentials" OFF)
 option(SVN_ENABLE_SASL "Enable Cyrus SASL v2" OFF)
 option(SVN_ENABLE_LIBMAGIC "Enable libmagic filetype detection library")
+cmake_dependent_option(SVN_ENABLE_AUTH_KEYCHAIN "Enable macOS Keychain for auth credentials" ON "APPLE" OFF)
 cmake_dependent_option(SVN_ENABLE_AUTH_GPG_AGENT "Enable GPG Agent support" OFF "WIN32" ON)
 
 option(SVN_INSTALL_PRIVATE_H "Install private header files." OFF)
@@ -720,6 +721,28 @@ if(SVN_ENABLE_AUTH_GNOME_KEYRING)
   )
 endif()
 
+### macOS Keychain
+
+if(SVN_ENABLE_AUTH_KEYCHAIN)
+  add_library(external-keychain INTERFACE)
+  target_link_libraries(external-keychain INTERFACE
+    "-framework CoreFoundation"
+    "-framework Security"
+  )
+
+  add_private_config_definition(
+    "Defined if macOS KeyChain Services support is enabled"
+    "SVN_HAVE_KEYCHAIN_SERVICES" "1"
+  )
+  add_private_config_definition(
+    "Defined if macOS SecItem API is available"
+    "SVN_HAVE_KEYCHAIN_SECITEM_API" "1"
+  )
+
+  target_link_libraries(libsvn_subr PRIVATE external-keychain)
+endif()
+
+
 if (SVN_ENABLE_TUI)
   add_library(external-ncurses INTERFACE)
 
@@ -1111,6 +1134,13 @@ endif()
 string(TOLOWER "${CMAKE_HOST_SYSTEM_PROCESSOR}-${CMAKE_HOST_SYSTEM_NAME}" SVN_BUILD_HOST)
 string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}-${CMAKE_SYSTEM_NAME}" SVN_BUILD_TARGET)
 
+# Build environment info (hardcoded at configure time)
+set(SVN_BUILD_COMPILER "${CMAKE_C_COMPILER_ID}")
+set(SVN_BUILD_COMPILER_VERSION "${CMAKE_C_COMPILER_VERSION}")
+set(SVN_BUILD_OS "${CMAKE_SYSTEM_NAME}")
+set(SVN_BUILD_OS_VERSION "${CMAKE_SYSTEM_VERSION}")
+set(SVN_BUILD_ARCH "${CMAKE_SYSTEM_PROCESSOR}")
+
 configure_file(
   "${CMAKE_CURRENT_SOURCE_DIR}/subversion/svn_private_config.hc"
   "${CMAKE_CURRENT_BINARY_DIR}/svn_private_config.h"
