diff --git a/subversion/svn/help-cmd.c b/subversion/svn/help-cmd.c
index e26a047ec3..98a0c16abb 100644
--- a/subversion/svn/help-cmd.c
+++ b/subversion/svn/help-cmd.c
@@ -154,6 +154,30 @@ svn_cl__help(apr_getopt_t *os,
       opt_state = cmd_baton->opt_state;
     }
 
+  /*
+   * Show build environment info (hardcoded at compile time).
+   */
+  svn_stringbuf_appendcstr(version_footer,
+                           _("Build environment:\n\n"));
+  svn_stringbuf_appendcstr(
+      version_footer,
+      apr_psprintf(pool, _("* Compiler: %s %s\n"),
+                   SVN_BUILD_COMPILER, SVN_BUILD_COMPILER_VERSION));
+  svn_stringbuf_appendcstr(
+      version_footer,
+      apr_psprintf(pool, _("* OS: %s %s\n"),
+                   SVN_BUILD_OS, SVN_BUILD_OS_VERSION));
+  svn_stringbuf_appendcstr(
+      version_footer,
+      apr_psprintf(pool, _("* Architecture: %s\n"), SVN_BUILD_ARCH));
+#ifdef __GLIBC__
+  svn_stringbuf_appendcstr(
+      version_footer,
+      apr_psprintf(pool, _("* libc: glibc %d.%d\n"),
+                   __GLIBC__, __GLIBC_MINOR__));
+#endif
+  svn_stringbuf_appendcstr(version_footer, "\n");
+
   /*
    * Show supported working copy versions.
    */
